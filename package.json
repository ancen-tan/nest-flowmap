{
  "name": "nest-flowmap",
  "version": "0.1.0",
  "private": true,
  "description": "Static documentation for NestJS APIs: per-endpoint flowcharts, an offline viewer, OpenAPI 3.0.0, Postman and Bruno exports (no LLM, runs locally)",
  "license": "MIT",
  "bin": {
    "nest-flowmap": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/flowmap.test.js"
  },
  "dependencies": {
    "mermaid": "^11.4.0",
    "ts-morph": "^27.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
